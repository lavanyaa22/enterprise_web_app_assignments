import java.util.Scanner;

public class q9 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.print("Enter base: ");
        int base = sc.nextInt();

        System.out.print("Enter exponent: ");
        int exp = sc.nextInt();

        long power = 1;

        for (int i = 1; i <= exp; i++) {
            power *= base;
        }

        System.out.println("Result = " + power);

        sc.close();
    }
}
